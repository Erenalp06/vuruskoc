// Cloudflare Workers — static-assets only (no server code). Used by Workers
// Builds (Git-connected CI). The build produces web/dist; wrangler deploys it.
{
  "name": "vuruskoc",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
